generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PLANNER
  PRODUCTION_MANAGER
  OPERATOR
  QUALITY_STAFF
  VIEWER
}

enum MachineStatus {
  IDLE
  RUNNING
  STOPPED
  MAINTENANCE
}

enum WorkOrderStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum WorkOrderOperationStatus {
  WAITING
  READY
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum OperationMessageSeverity {
  INFO
  WARNING
  QUALITY_ALERT
  STOPPAGE
}

enum QualityStatus {
  PASSED
  FAILED
  PARTIAL
}

enum AlertStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  RESOLVED
  COMMENT
}

enum QualityActionDecision {
  REWORK_OPERATION
  SCRAP
  CONDITIONAL_ACCEPT
}

enum ScrapReason {
  MATERIAL_DEFECT
  MACHINE_SETUP
  OPERATOR_ERROR
  PROCESS_DEVIATION
  QUALITY_REJECT
  OTHER
}

enum ScrapDisposition {
  PENDING_REVIEW
  REWORK
  SCRAP
  REPRODUCE
  CONDITIONAL_ACCEPT
}

enum ScrapActionStatus {
  PENDING
  CREATED
  NOT_REQUIRED
}

enum DowntimeReason {
  MACHINE_FAILURE
  MATERIAL_WAITING
  QUALITY_WAITING
  MAINTENANCE
  SETUP
  OPERATOR_BREAK
  OTHER
}

enum ShiftAssignmentStatus {
  PLANNED
  CONFIRMED
  ABSENT
  LEAVE
}

enum MachineSkillLevel {
  BASIC
  ADVANCED
  CERTIFIED
}

enum ShiftTemplatePattern {
  WEEKDAYS
  SIX_DAYS
  EVERY_DAY
  FOUR_ON_TWO_OFF
}

enum StockMovementType {
  PURCHASE_IN
  PRODUCTION_IN
  CONSUMPTION_OUT
  SCRAP_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PLANNED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

model User {
  id                 String                 @id @default(uuid())
  name               String
  email              String                 @unique
  passwordHash       String
  employeeCode       String?                @unique
  phone              String?
  department         String?
  position           String?
  hireDate           DateTime?              @db.Date
  terminationDate    DateTime?              @db.Date
  emergencyContactName  String?
  emergencyContactPhone String?
  role               UserRole               @default(OPERATOR)
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  createdWorkOrders  WorkOrder[]            @relation("CreatedWorkOrders")
  assignedWorkOrders WorkOrder[]            @relation("AssignedWorkOrders")
  assignedOperations WorkOrderOperation[]   @relation("AssignedWorkOrderOperations")
  operationMessages  OperationMessage[]
  productionLogs     ProductionLog[]
  operationDowntimes OperationDowntime[]
  createdAlerts      ProductionAlert[]      @relation("CreatedAlerts")
  assignedAlerts     ProductionAlert[]      @relation("AssignedAlerts")
  resolvedAlerts     ProductionAlert[]      @relation("ResolvedAlerts")
  alertEvents        ProductionAlertEvent[]
  qualityChecks      QualityCheck[]
  machineStatusLogs  MachineStatusLog[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  pushTokens         PushToken[]
  mobileDebugLogs    MobileDebugLog[]
  shiftAssignments   ShiftAssignment[]
  machineSkills      OperatorMachineSkill[]
  operatorGroups     OperatorGroupMember[]
  stockMovements     StockMovement[]
  createdSalesOrders SalesOrder[]          @relation("CreatedSalesOrders")
}

model Product {
  id              String         @id @default(uuid())
  code            String         @unique
  name            String
  unit            String         @default("pcs")
  targetCycleTime Int?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  workOrders      WorkOrder[]
  routes          ProductRoute[]
  bomItems        ProductBomItem[] @relation("ProductBomParent")
  usedInBomItems  ProductBomItem[] @relation("ProductBomComponent")
  stockItem       StockItem?
  stockMovements  StockMovement[]
  salesOrderItems SalesOrderItem[]
}

model SalesOrder {
  id            String           @id @default(uuid())
  orderNo       String           @unique
  customerName  String
  requestedDate DateTime?
  dueDate       DateTime?
  status        SalesOrderStatus @default(DRAFT)
  note          String?
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     User             @relation("CreatedSalesOrders", fields: [createdById], references: [id])
  items         SalesOrderItem[]
  workOrders    WorkOrder[]

  @@index([status, dueDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String      @id @default(uuid())
  salesOrderId String
  productId    String
  quantity     Int
  unit         String      @default("adet")
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  salesOrder   SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product     @relation(fields: [productId], references: [id])
  workOrders   WorkOrder[]

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

model ProductBomItem {
  id                 String   @id @default(uuid())
  productId          String
  componentProductId String
  quantity           Decimal  @db.Decimal(12, 3)
  unit               String
  wastePercent       Decimal  @default(0) @db.Decimal(5, 2)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  product            Product  @relation("ProductBomParent", fields: [productId], references: [id], onDelete: Cascade)
  componentProduct   Product  @relation("ProductBomComponent", fields: [componentProductId], references: [id])

  @@unique([productId, componentProductId])
  @@index([componentProductId])
  @@map("product_bom_items")
}

model StockItem {
  id               String          @id @default(uuid())
  productId        String          @unique
  quantityOnHand   Decimal         @default(0) @db.Decimal(14, 3)
  reservedQuantity Decimal         @default(0) @db.Decimal(14, 3)
  minimumQuantity  Decimal         @default(0) @db.Decimal(14, 3)
  location         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements        StockMovement[]

  @@map("stock_items")
}

model StockMovement {
  id            String            @id @default(uuid())
  stockItemId   String
  productId     String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 3)
  balanceAfter  Decimal           @db.Decimal(14, 3)
  referenceType String?
  referenceId   String?
  note          String?
  createdById   String
  createdAt     DateTime          @default(now())
  stockItem     StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id])
  createdBy     User              @relation(fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@index([type])
  @@map("stock_movements")
}

model ProductionLine {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  machines    Machine[]
}

model Machine {
  id                     String               @id @default(uuid())
  code                   String               @unique
  name                   String
  productionLineId       String
  status                 MachineStatus        @default(IDLE)
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  productionLine         ProductionLine       @relation(fields: [productionLineId], references: [id])
  workOrders             WorkOrder[]
  workOrderOperations    WorkOrderOperation[]
  productionLogs         ProductionLog[]
  operationDowntimes     OperationDowntime[]
  machineStatusLogs      MachineStatusLog[]
  defaultRouteOperations RouteOperation[]
  operatorSkills         OperatorMachineSkill[]
}

model ProductRoute {
  id          String           @id @default(uuid())
  productId   String
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  product     Product          @relation(fields: [productId], references: [id])
  operations  RouteOperation[]
  workOrders  WorkOrder[]

  @@unique([productId, name])
  @@map("routes")
}

model RouteOperation {
  id                   String               @id @default(uuid())
  routeId              String
  operationName        String
  sequenceNo           Int
  defaultMachineId     String?
  estimatedMinutes     Int?
  requiresQualityCheck Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  route                ProductRoute         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  defaultMachine       Machine?             @relation(fields: [defaultMachineId], references: [id])
  workOrderOperations  WorkOrderOperation[]

  @@unique([routeId, sequenceNo])
  @@map("route_operations")
}

model Shift {
  id                 String              @id @default(uuid())
  name               String              @unique
  startTime          String
  endTime            String
  isActive           Boolean             @default(true)
  productionLogs     ProductionLog[]
  operationDowntimes OperationDowntime[]
  assignments        ShiftAssignment[]
  templates          ShiftTemplate[]
}

model OperatorGroup {
  id          String                @id @default(uuid())
  name        String                @unique
  description String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  members     OperatorGroupMember[]
  templates   ShiftTemplate[]

  @@map("operator_groups")
}

model OperatorGroupMember {
  id         String        @id @default(uuid())
  groupId    String
  operatorId String
  createdAt  DateTime      @default(now())
  group      OperatorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  operator   User          @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@unique([groupId, operatorId])
  @@index([operatorId])
  @@map("operator_group_members")
}

model ShiftTemplate {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  pattern     ShiftTemplatePattern @default(WEEKDAYS)
  shiftId     String
  groupId     String?
  startOffset Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  shift       Shift                @relation(fields: [shiftId], references: [id])
  group       OperatorGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([shiftId])
  @@index([groupId])
  @@map("shift_templates")
}

model ShiftAssignment {
  id         String                 @id @default(uuid())
  operatorId String
  shiftId    String
  workDate   DateTime               @db.Date
  startTime  String?
  endTime    String?
  status     ShiftAssignmentStatus  @default(PLANNED)
  note       String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  operator   User                   @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  shift      Shift                  @relation(fields: [shiftId], references: [id])

  @@unique([operatorId, workDate])
  @@index([shiftId, workDate])
  @@index([workDate])
  @@map("shift_assignments")
}

model OperatorMachineSkill {
  id         String            @id @default(uuid())
  operatorId String
  machineId  String
  level      MachineSkillLevel @default(BASIC)
  isActive   Boolean           @default(true)
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  operator   User              @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  machine    Machine           @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([operatorId, machineId])
  @@index([machineId, isActive])
  @@index([operatorId, isActive])
  @@map("operator_machine_skills")
}

model WorkOrder {
  id                 String               @id @default(uuid())
  orderNo            String               @unique
  productId          String
  routeId            String?
  machineId          String?
  assignedOperatorId String?
  plannedQuantity    Int
  producedQuantity   Int                  @default(0)
  scrapQuantity      Int                  @default(0)
  status             WorkOrderStatus      @default(PLANNED)
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  salesOrderId       String?
  salesOrderItemId   String?
  createdById        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  product            Product              @relation(fields: [productId], references: [id])
  route              ProductRoute?        @relation(fields: [routeId], references: [id])
  machine            Machine?             @relation(fields: [machineId], references: [id])
  assignedOperator   User?                @relation("AssignedWorkOrders", fields: [assignedOperatorId], references: [id])
  createdBy          User                 @relation("CreatedWorkOrders", fields: [createdById], references: [id])
  salesOrder         SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  salesOrderItem     SalesOrderItem?      @relation(fields: [salesOrderItemId], references: [id])
  productionLogs     ProductionLog[]
  productionAlerts   ProductionAlert[]
  qualityChecks      QualityCheck[]
  operations         WorkOrderOperation[]
  operationDowntimes OperationDowntime[]

  @@index([salesOrderId])
  @@index([salesOrderItemId])
}

model WorkOrderOperation {
  id                 String                   @id @default(uuid())
  workOrderId        String
  routeOperationId   String
  machineId          String?
  assignedOperatorId String?
  sequenceNo         Int
  operationName      String
  status             WorkOrderOperationStatus @default(WAITING)
  producedQuantity   Int                      @default(0)
  scrapQuantity      Int                      @default(0)
  version            Int                      @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  workOrder          WorkOrder                @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  routeOperation     RouteOperation           @relation(fields: [routeOperationId], references: [id])
  machine            Machine?                 @relation(fields: [machineId], references: [id])
  assignedOperator   User?                    @relation("AssignedWorkOrderOperations", fields: [assignedOperatorId], references: [id])
  messages           OperationMessage[]
  productionLogs     ProductionLog[]
  qualityChecks      QualityCheck[]
  downtimes          OperationDowntime[]
  qualityReworkAlerts ProductionAlert[]        @relation("QualityReworkOperation")

  @@unique([workOrderId, sequenceNo])
  @@map("work_order_operations")
}

model OperationMessage {
  id                   String                   @id @default(uuid())
  workOrderOperationId String
  senderId             String
  message              String
  severity             OperationMessageSeverity @default(INFO)
  createdAt            DateTime                 @default(now())
  workOrderOperation   WorkOrderOperation       @relation(fields: [workOrderOperationId], references: [id], onDelete: Cascade)
  sender               User                     @relation(fields: [senderId], references: [id])

  @@map("operation_messages")
}

model OperationDowntime {
  id                   String             @id @default(uuid())
  workOrderId          String
  workOrderOperationId String
  machineId            String?
  operatorId           String?
  shiftId              String?
  reason               DowntimeReason
  note                 String?
  startedAt            DateTime           @default(now())
  endedAt              DateTime?
  createdAt            DateTime           @default(now())
  workOrder            WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workOrderOperation   WorkOrderOperation @relation(fields: [workOrderOperationId], references: [id], onDelete: Cascade)
  machine              Machine?           @relation(fields: [machineId], references: [id])
  operator             User?              @relation(fields: [operatorId], references: [id])
  shift                Shift?             @relation(fields: [shiftId], references: [id])

  @@index([workOrderOperationId, startedAt])
  @@index([machineId, startedAt])
  @@index([shiftId, startedAt])
  @@map("operation_downtimes")
}

model ProductionLog {
  id                   String                    @id @default(uuid())
  workOrderId          String
  workOrderOperationId String?
  operatorId           String
  machineId            String
  shiftId              String?
  producedQuantity     Int
  scrapQuantity        Int                       @default(0)
  scrapReason          ScrapReason?
  scrapDisposition     ScrapDisposition?
  scrapResolutionQuantity Int                    @default(0)
  scrapDispositionNote String?
  scrapActionStatus    ScrapActionStatus         @default(PENDING)
  scrapActionWorkOrderId String?
  scrapActionWorkOrderNo String?
  scrapActionNote      String?
  startedAt            DateTime?
  endedAt              DateTime?
  note                 String?
  createdAt            DateTime                  @default(now())
  workOrder            WorkOrder                 @relation(fields: [workOrderId], references: [id])
  workOrderOperation   WorkOrderOperation?       @relation(fields: [workOrderOperationId], references: [id])
  operator             User                      @relation(fields: [operatorId], references: [id])
  machine              Machine                   @relation(fields: [machineId], references: [id])
  shift                Shift?                    @relation(fields: [shiftId], references: [id])
  attachments          ProductionLogAttachment[]
  alerts               ProductionAlert[]
}

model ProductionLogAttachment {
  id              String        @id @default(uuid())
  productionLogId String
  fileName        String
  fileUrl         String
  mimeType        String
  size            Int
  createdAt       DateTime      @default(now())
  productionLog   ProductionLog @relation(fields: [productionLogId], references: [id])
}

model ProductionAlert {
  id              String                 @id @default(uuid())
  productionLogId String
  workOrderId     String
  createdById     String
  assignedToId    String?
  resolvedById    String?
  title           String
  message         String
  severity        AlertSeverity          @default(WARNING)
  status          AlertStatus            @default(OPEN)
  resolutionNote  String?
  qualityDecision QualityActionDecision?
  qualityDecisionNote String?
  reworkOperationId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  resolvedAt      DateTime?
  productionLog   ProductionLog          @relation(fields: [productionLogId], references: [id])
  workOrder       WorkOrder              @relation(fields: [workOrderId], references: [id])
  createdBy       User                   @relation("CreatedAlerts", fields: [createdById], references: [id])
  assignedTo      User?                  @relation("AssignedAlerts", fields: [assignedToId], references: [id])
  resolvedBy      User?                  @relation("ResolvedAlerts", fields: [resolvedById], references: [id])
  reworkOperation WorkOrderOperation?    @relation("QualityReworkOperation", fields: [reworkOperationId], references: [id])
  events          ProductionAlertEvent[]
}

model ProductionAlertEvent {
  id         String          @id @default(uuid())
  alertId    String
  actorId    String
  type       AlertEventType
  fromStatus AlertStatus?
  toStatus   AlertStatus?
  note       String?
  createdAt  DateTime        @default(now())
  alert      ProductionAlert @relation(fields: [alertId], references: [id])
  actor      User            @relation(fields: [actorId], references: [id])
}

model QualityCheck {
  id                   String              @id @default(uuid())
  workOrderId          String
  workOrderOperationId String?
  checkedById          String
  status               QualityStatus
  defectQuantity       Int                 @default(0)
  defectReason         String?
  note                 String?
  checkedAt            DateTime            @default(now())
  workOrder            WorkOrder           @relation(fields: [workOrderId], references: [id])
  workOrderOperation   WorkOrderOperation? @relation(fields: [workOrderOperationId], references: [id])
  checkedBy            User                @relation(fields: [checkedById], references: [id])
}

model MachineStatusLog {
  id          String        @id @default(uuid())
  machineId   String
  status      MachineStatus
  reason      String?
  changedById String
  createdAt   DateTime      @default(now())
  machine     Machine       @relation(fields: [machineId], references: [id])
  changedBy   User          @relation(fields: [changedById], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model DomainEventLog {
  id         String   @id @default(uuid())
  eventId    String   @unique
  type       String
  entityType String?
  entityId   String?
  summary    String?
  payload    Json?
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([occurredAt])
  @@index([entityType, entityId])
  @@map("domain_event_logs")
}

model Notification {
  id          String    @id @default(uuid())
  recipientId String
  type        String
  title       String
  message     String
  entityType  String?
  entityId    String?
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User      @relation(fields: [recipientId], references: [id])

  @@index([recipientId, readAt, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String
  deviceName String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("push_tokens")
}

model MobileDebugLog {
  id        String   @id @default(uuid())
  userId    String
  category  String
  step      String
  platform  String?
  payload   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([category, step, createdAt])
  @@map("mobile_debug_logs")
}
