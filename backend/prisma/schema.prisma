generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PRODUCTION_MANAGER
  OPERATOR
  QUALITY_STAFF
  VIEWER
}

enum MachineStatus {
  IDLE
  RUNNING
  STOPPED
  MAINTENANCE
}

enum WorkOrderStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum WorkOrderOperationStatus {
  WAITING
  READY
  IN_PROGRESS
  PAUSED
  COMPLETED
}

enum OperationMessageSeverity {
  INFO
  WARNING
  QUALITY_ALERT
  STOPPAGE
}

enum QualityStatus {
  PASSED
  FAILED
  PARTIAL
}

enum AlertStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  RESOLVED
  COMMENT
}

enum ScrapReason {
  MATERIAL_DEFECT
  MACHINE_SETUP
  OPERATOR_ERROR
  PROCESS_DEVIATION
  QUALITY_REJECT
  OTHER
}

model User {
  id                 String                 @id @default(uuid())
  name               String
  email              String                 @unique
  passwordHash       String
  role               UserRole               @default(OPERATOR)
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  createdWorkOrders  WorkOrder[]            @relation("CreatedWorkOrders")
  assignedWorkOrders WorkOrder[]            @relation("AssignedWorkOrders")
  assignedOperations WorkOrderOperation[]   @relation("AssignedWorkOrderOperations")
  operationMessages  OperationMessage[]
  productionLogs     ProductionLog[]
  createdAlerts      ProductionAlert[]      @relation("CreatedAlerts")
  assignedAlerts     ProductionAlert[]      @relation("AssignedAlerts")
  resolvedAlerts     ProductionAlert[]      @relation("ResolvedAlerts")
  alertEvents        ProductionAlertEvent[]
  qualityChecks      QualityCheck[]
  machineStatusLogs  MachineStatusLog[]
}

model Product {
  id              String         @id @default(uuid())
  code            String         @unique
  name            String
  unit            String         @default("pcs")
  targetCycleTime Int?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  workOrders      WorkOrder[]
  routes          ProductRoute[]
}

model ProductionLine {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  machines    Machine[]
}

model Machine {
  id                     String               @id @default(uuid())
  code                   String               @unique
  name                   String
  productionLineId       String
  status                 MachineStatus        @default(IDLE)
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  productionLine         ProductionLine       @relation(fields: [productionLineId], references: [id])
  workOrders             WorkOrder[]
  workOrderOperations    WorkOrderOperation[]
  productionLogs         ProductionLog[]
  machineStatusLogs      MachineStatusLog[]
  defaultRouteOperations RouteOperation[]
}

model ProductRoute {
  id          String           @id @default(uuid())
  productId   String
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  product     Product          @relation(fields: [productId], references: [id])
  operations  RouteOperation[]
  workOrders  WorkOrder[]

  @@unique([productId, name])
  @@map("routes")
}

model RouteOperation {
  id                   String               @id @default(uuid())
  routeId              String
  operationName        String
  sequenceNo           Int
  defaultMachineId     String?
  estimatedMinutes     Int?
  requiresQualityCheck Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  route                ProductRoute         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  defaultMachine       Machine?             @relation(fields: [defaultMachineId], references: [id])
  workOrderOperations  WorkOrderOperation[]

  @@unique([routeId, sequenceNo])
  @@map("route_operations")
}

model Shift {
  id             String          @id @default(uuid())
  name           String          @unique
  startTime      String
  endTime        String
  isActive       Boolean         @default(true)
  productionLogs ProductionLog[]
}

model WorkOrder {
  id                 String               @id @default(uuid())
  orderNo            String               @unique
  productId          String
  routeId            String?
  machineId          String?
  assignedOperatorId String?
  plannedQuantity    Int
  producedQuantity   Int                  @default(0)
  scrapQuantity      Int                  @default(0)
  status             WorkOrderStatus      @default(PLANNED)
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  createdById        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  product            Product              @relation(fields: [productId], references: [id])
  route              ProductRoute?        @relation(fields: [routeId], references: [id])
  machine            Machine?             @relation(fields: [machineId], references: [id])
  assignedOperator   User?                @relation("AssignedWorkOrders", fields: [assignedOperatorId], references: [id])
  createdBy          User                 @relation("CreatedWorkOrders", fields: [createdById], references: [id])
  productionLogs     ProductionLog[]
  productionAlerts   ProductionAlert[]
  qualityChecks      QualityCheck[]
  operations         WorkOrderOperation[]
}

model WorkOrderOperation {
  id                 String                   @id @default(uuid())
  workOrderId        String
  routeOperationId   String
  machineId          String?
  assignedOperatorId String?
  sequenceNo         Int
  operationName      String
  status             WorkOrderOperationStatus @default(WAITING)
  producedQuantity   Int                      @default(0)
  scrapQuantity      Int                      @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  workOrder          WorkOrder                @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  routeOperation     RouteOperation           @relation(fields: [routeOperationId], references: [id])
  machine            Machine?                 @relation(fields: [machineId], references: [id])
  assignedOperator   User?                    @relation("AssignedWorkOrderOperations", fields: [assignedOperatorId], references: [id])
  messages           OperationMessage[]
  productionLogs     ProductionLog[]
  qualityChecks      QualityCheck[]

  @@unique([workOrderId, sequenceNo])
  @@map("work_order_operations")
}

model OperationMessage {
  id                   String                   @id @default(uuid())
  workOrderOperationId String
  senderId             String
  message              String
  severity             OperationMessageSeverity @default(INFO)
  createdAt            DateTime                 @default(now())
  workOrderOperation   WorkOrderOperation       @relation(fields: [workOrderOperationId], references: [id], onDelete: Cascade)
  sender               User                     @relation(fields: [senderId], references: [id])

  @@map("operation_messages")
}

model ProductionLog {
  id                   String                    @id @default(uuid())
  workOrderId          String
  workOrderOperationId String?
  operatorId           String
  machineId            String
  shiftId              String?
  producedQuantity     Int
  scrapQuantity        Int                       @default(0)
  scrapReason          ScrapReason?
  startedAt            DateTime?
  endedAt              DateTime?
  note                 String?
  createdAt            DateTime                  @default(now())
  workOrder            WorkOrder                 @relation(fields: [workOrderId], references: [id])
  workOrderOperation   WorkOrderOperation?       @relation(fields: [workOrderOperationId], references: [id])
  operator             User                      @relation(fields: [operatorId], references: [id])
  machine              Machine                   @relation(fields: [machineId], references: [id])
  shift                Shift?                    @relation(fields: [shiftId], references: [id])
  attachments          ProductionLogAttachment[]
  alerts               ProductionAlert[]
}

model ProductionLogAttachment {
  id              String        @id @default(uuid())
  productionLogId String
  fileName        String
  fileUrl         String
  mimeType        String
  size            Int
  createdAt       DateTime      @default(now())
  productionLog   ProductionLog @relation(fields: [productionLogId], references: [id])
}

model ProductionAlert {
  id              String                 @id @default(uuid())
  productionLogId String
  workOrderId     String
  createdById     String
  assignedToId    String?
  resolvedById    String?
  title           String
  message         String
  severity        AlertSeverity          @default(WARNING)
  status          AlertStatus            @default(OPEN)
  resolutionNote  String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  resolvedAt      DateTime?
  productionLog   ProductionLog          @relation(fields: [productionLogId], references: [id])
  workOrder       WorkOrder              @relation(fields: [workOrderId], references: [id])
  createdBy       User                   @relation("CreatedAlerts", fields: [createdById], references: [id])
  assignedTo      User?                  @relation("AssignedAlerts", fields: [assignedToId], references: [id])
  resolvedBy      User?                  @relation("ResolvedAlerts", fields: [resolvedById], references: [id])
  events          ProductionAlertEvent[]
}

model ProductionAlertEvent {
  id         String          @id @default(uuid())
  alertId    String
  actorId    String
  type       AlertEventType
  fromStatus AlertStatus?
  toStatus   AlertStatus?
  note       String?
  createdAt  DateTime        @default(now())
  alert      ProductionAlert @relation(fields: [alertId], references: [id])
  actor      User            @relation(fields: [actorId], references: [id])
}

model QualityCheck {
  id                   String              @id @default(uuid())
  workOrderId          String
  workOrderOperationId String?
  checkedById          String
  status               QualityStatus
  defectQuantity       Int                 @default(0)
  defectReason         String?
  note                 String?
  checkedAt            DateTime            @default(now())
  workOrder            WorkOrder           @relation(fields: [workOrderId], references: [id])
  workOrderOperation   WorkOrderOperation? @relation(fields: [workOrderOperationId], references: [id])
  checkedBy            User                @relation(fields: [checkedById], references: [id])
}

model MachineStatusLog {
  id          String        @id @default(uuid())
  machineId   String
  status      MachineStatus
  reason      String?
  changedById String
  createdAt   DateTime      @default(now())
  machine     Machine       @relation(fields: [machineId], references: [id])
  changedBy   User          @relation(fields: [changedById], references: [id])
}
