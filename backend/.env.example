NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mes_lite?schema=public"
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="1d"

# Comma separated web/mobile origins allowed to call the API.
# Production example:
# CORS_ORIGINS="https://mes-lite-web.vercel.app,https://your-mobile-preview-domain.com"
CORS_ORIGINS="http://localhost:5173,http://localhost:8081,http://localhost:19006"
