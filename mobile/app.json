{
  "expo": {
    "name": "MES Lite",
    "slug": "mes-lite-mobile",
    "scheme": "meslite",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.meslite.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.meslite.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Operatorler uretim kaydina gorsel kanit eklemek icin kamerayi kullanir.",
        "NSPhotoLibraryUsageDescription": "Operatorler uretim kaydina galeriden gorsel kanit ekler."
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Operatorler uretim kaydina galeriden gorsel kanit ekler.",
          "cameraPermission": "Operatorler uretim kaydina gorsel kanit eklemek icin kamerayi kullanir."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "https://meslite-production.up.railway.app/api",
      "eas": {
        "projectId": "24e1f2e1-73f0-49f4-9708-2878666d5c25"
      }
    },
    "owner": "evindar"
  }
}
